# ============================================================================
# .env — Almighty Anand Studio Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================================

# ── GCP Infrastructure ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a
GPU_VM_NAME=almighty-gpu-worker
CPU_VM_IP=10.128.0.2
GPU_VM_IP=10.128.0.3
GCS_BUCKET=your-gcp-project-id-almighty-assets
BUDGET_ALERT_EMAIL=your@email.com

# ── YouTube API (OAuth2 credentials) ──────────────────────────────
# Generate via: https://console.cloud.google.com/apis/credentials
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_CREDS=/app/data/youtube_creds.json
YOUTUBE_CHANNEL_ID_EN=your-english-channel-id
YOUTUBE_CHANNEL_ID_HI=your-hindi-channel-id

# ── Instagram (via instagrapi) ────────────────────────────────────
INSTAGRAM_USERNAME=almightyanand
INSTAGRAM_PASSWORD=

# ── LLM & AI API Keys (for OmniRoute & Media Dispatcher) ──────────
# Free tiers — fill in whichever you have
GOOGLE_API_KEY=                          # Gemini Flash/Pro free tier
GROQ_API_KEY=                            # Groq free tier (Llama 3.3)
HF_TOKEN=                                # Hugging Face token (FLUX.1-schnell inference)
POLLINATIONS_API_KEY=                    # Pollinations API key for high-speed FLUX generation
MISTRAL_API_KEY=                         # Mistral free tier
OPENROUTER_API_KEY=                      # OpenRouter free models

# Paid fallback (optional — only used when free tiers exhausted)
OPENAI_API_KEY=

# ── Voice Cloning ─────────────────────────────────────────────────
VOICE_PROFILE_PATH=/app/data/voice_samples/almighty_anand/
VOICE_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# ── Affiliate Links ──────────────────────────────────────────────
AFFILIATE_TECH_URL=https://amzn.to/your-tech-tag
AFFILIATE_BOOKS_URL=https://amzn.to/your-books-tag
AFFILIATE_BROKER_URL=https://your-broker-referral-link
AFFILIATE_SPIRITUAL_URL=https://amzn.to/your-spiritual-tag

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Notifications ─────────────────────────────────────────────────
ALERT_EMAIL=your@email.com

# ── Feature Flags ─────────────────────────────────────────────────
GPU_CONTROLLER_ENABLED=true
AUTO_PUBLISH=true
SAFETY_CHECK=true
HINDI_DUBBING=true
INSTAGRAM_ENABLED=true
