# ============================================================================
# .env — Almighty Anand Studio Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# Leave a value empty to disable that feature. Keep comments on their own lines.
# ============================================================================

# ── GCP Infrastructure ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
# Needed by infra/gcp_setup.sh to create the budget alerts (gcloud billing accounts list)
BILLING_ACCOUNT_ID=
GCP_ZONE=us-central1-a
GPU_VM_NAME=almighty-gpu-worker
CPU_VM_IP=10.128.0.2
GPU_VM_IP=10.128.0.3
GCS_BUCKET=your-gcp-project-id-almighty-assets
BUDGET_ALERT_EMAIL=your@email.com

# ── YouTube API (OAuth2 credentials) ──────────────────────────────
# Generate via: https://console.cloud.google.com/apis/credentials
# The stored token (configs/youtube_token.json) needs these scopes:
#   youtube.upload, youtube.force-ssl (comment), yt-analytics.readonly (nightly review)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID_EN=your-english-channel-id
YOUTUBE_CHANNEL_ID_HI=your-hindi-channel-id
# public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public

# ── LLM & AI API Keys ─────────────────────────────────────────────
# Gemini (scripts, and the vision QA gate)
GOOGLE_API_KEY=
# Groq (script fallback)
GROQ_API_KEY=
# Hugging Face token (FLUX.1-schnell image fallback)
HF_TOKEN=
# Pollinations API key (primary FLUX image generation)
POLLINATIONS_API_KEY=
# Pexels API key (last-resort royalty-free images)
PEXELS_API_KEY=

# ── Voice ─────────────────────────────────────────────────────────
# Sarvam Bulbul speaks Hinglish from the Devanagari voice track. Without a key,
# the free Edge-TTS voice is used. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# auto = Sarvam when a key is set, else Edge | sarvam = fail if Sarvam fails | edge
TTS_PROVIDER=auto
# bulbul:v3 (speaker names like shubh, ritu) or bulbul:v4-flash (persona ids like sunny_hi_reels)
SARVAM_TTS_MODEL=bulbul:v3

# ── Look, host and sound ──────────────────────────────────────────
# Preset from configs/visual_style.json. Leave empty to use its "active" value.
VISUAL_STYLE=
# Show the character in the host zone (art goes in assets/character/)
HOST_ENABLED=true
# Whoosh on cuts and a hit on the reveal
SFX_ENABLED=true
# Rotate the visual style after 3 weak days. Off keeps one recognisable look.
STYLE_PIVOT_ENABLED=false

# ── Affiliate Links ──────────────────────────────────────────────
# Only real https:// links are used; empty or placeholder values are ignored.
# Links in Shorts descriptions and comments are NOT clickable on YouTube, so
# Shorts only point viewers to your channel profile. Put these links there.
AFFILIATE_TECH_URL=
AFFILIATE_BOOKS_URL=
AFFILIATE_BROKER_URL=
AFFILIATE_SPIRITUAL_URL=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Pipeline behaviour ────────────────────────────────────────────
# false = render and queue only; nothing is uploaded
AUTO_PUBLISH=true
# true = a queued Short is published only after `python -m agents.review approve <n>`.
# Recommended: add your own line first with `python -m agents.review take <n> "..."`.
REVIEW_REQUIRED=true
# Shorts scripted per morning batch. One a day that you add your take to beats
# three that look mass-produced (maximum useful value: 3, one per publish slot).
SHORTS_PER_DAY=1
# Minimum characters of fetched article text before a topic may be scripted
MIN_SOURCE_CHARS=600
# A video needs this many views before its retention is used for learning
ANALYTICS_MIN_VIEWS=100
# Days to keep renders, rejected renders and QA keyframes on disk
RENDER_RETENTION_DAYS=7

# ── GPU worker ────────────────────────────────────────────────────
# Keep false: the services in docker-compose.gpu.yml are placeholders that do
# not generate media yet. Images come from Pollinations / Hugging Face / Pexels.
GPU_CONTROLLER_ENABLED=false
OPENGENAI_URL=http://10.128.0.3:8091

# ── Not implemented yet (read by no code) ─────────────────────────
INSTAGRAM_USERNAME=almightyanand
INSTAGRAM_PASSWORD=
HINDI_DUBBING=false
INSTAGRAM_ENABLED=false
